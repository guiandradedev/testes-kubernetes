Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  # 1º: o nó do minikube (precisa existir antes do bastion)
  config.vm.define "k8s" do |k8s|
    k8s.vm.hostname = "k8s"
    k8s.vm.network "private_network", ip: "192.168.56.11"
    # O build das imagens roda neste nó, então precisa enxergar o código das aplicações (raiz do projeto)
    k8s.vm.synced_folder "..", "/app"
    k8s.vm.provider "virtualbox" do |vb|
      vb.memory = 4096
      vb.cpus   = 2
    end
  end

  # 2º: o bastion, que roda o Ansible contra o k8s
  config.vm.define "bastion", primary: true do |b|
    b.vm.hostname = "bastion"
    b.vm.network "private_network", ip: "192.168.56.10"
    b.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus   = 1
    end

    # Copia a chave SSH da VM k8s com permissão correta
    b.vm.provision "shell", privileged: false, inline: <<-SHELL
      mkdir -p ~/.ssh
      cp /vagrant/.vagrant/machines/k8s/virtualbox/private_key ~/.ssh/k8s_key
      chmod 600 ~/.ssh/k8s_key
    SHELL

    b.vm.provision "ansible_local" do |ansible|
      ansible.playbook       = "ansible/site.yaml"
      ansible.inventory_path = "ansible/inventory.ini"
      ansible.limit          = "all"   # sem isso, o Vagrant limita ao próprio bastion
    end
  end
end